{
  "version": 2,
  "builds": [
    {
      "src": "web_app/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://ai-uv-vis-backend.onrender.com/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "web_app/$1"
    }
  ]
}
